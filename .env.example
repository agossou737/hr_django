# --- Obligatoire en production --------------------------------------------
# Générer : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines HTTPS autorisées pour les formulaires (production), ex. https://rh.mon-domaine.bj
CSRF_TRUSTED_ORIGINS=

# --- Base de données (vide = SQLite en développement) -----------------------
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Personnalisation (marque blanche) ----------------------------------------
APP_NAME=Ruche RH
APP_TAGLINE=Gestion RH & pointage facial

# --- Pointage facial -------------------------------------------------------------
# Plus petit = plus strict (0.4 très strict, 0.6 permissif)
FACE_MATCH_THRESHOLD=0.5
ATTENDANCE_MIN_INTERVAL_MINUTES=2

# --- Sécurité (production, DEBUG=False) ---------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_AGE=43200
LOG_LEVEL=INFO
